PORT=3000
NODE_ENV=development
# URI de MongoDB Atlas (o local: mongodb://localhost:27017/recetario)
MONGODB_URI=
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# URL publica del FRONT (las requests a /api llegan por el proxy / rewrite). Local: http://localhost:5173
BETTER_AUTH_URL=http://localhost:5173
# OAuth App de GitHub (una para local y otra para produccion)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Opcional: OAuth Client de Google. Si se dejan vacias, el login con Google queda deshabilitado.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Solo para `npm run seed`: contraseñas de los usuarios de prueba (minimo 8 caracteres)
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
